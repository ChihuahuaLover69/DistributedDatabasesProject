# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copia este archivo a .env y rellena los valores reales.
# El archivo .env NUNCA se sube a git (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Nodo 0 ────────────────────────────────────────────────────────────────────
NODE0_HOST=100.x.x.x          # IP Tailscale del Nodo 0
NODE0_PORT=3306
NODE0_DB=nombre_de_la_bd_0
NODE0_USER=nombre_usuario
NODE0_PASSWORD=contraseña_ascii_sin_ñ

# ── Nodo 1 ────────────────────────────────────────────────────────────────────
NODE1_HOST=100.x.x.x          # IP Tailscale del Nodo 1
NODE1_PORT=3306
NODE1_DB=nombre_de_la_bd_1
NODE1_USER=nombre_usuario
NODE1_PASSWORD=contraseña_ascii_sin_ñ

# ── Configuración general ─────────────────────────────────────────────────────
# Tamaño de bloque de IDs por nodo (no cambiar en producción con datos existentes)
BLOCK_SIZE=1500
